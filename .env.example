# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/media_inventory_db

# MCP Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8090
MCP_API_KEY=your-secure-mcp-api-key-here

# AWS S3 Configuration (Private Bucket)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=buzzomni-media-inventory
AWS_S3_BASE_URL=https://buzzomni-media-inventory.s3.ap-south-1.amazonaws.com/

# Presigned URL TTL in seconds (e.g. 900 = 15 minutes)
PRESIGNED_URL_EXPIRY=900
