[Unit]
Description=Media Inventory MCP Server (Streamable HTTP / SSE)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/documents/media-inventory/mcp
EnvironmentFile=/documents/media-inventory/mcp/.env
ExecStart=/documents/media-inventory/mcp/.venv/bin/uvicorn mcp_server.server:app --host 0.0.0.0 --port 8090 --workers 2 --timeout-keep-alive 65
Restart=always
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=media-inventory-mcp

[Install]
WantedBy=multi-user.target
