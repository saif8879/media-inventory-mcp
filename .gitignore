# Ignore everything in repository by default
/*

# Whitelist essential root configuration
!.gitignore
!README.md
!requirements.txt

# Whitelist Docker build files
!Dockerfile
!docker-compose.yml
!.dockerignore

# Whitelist mcp_server source package
!mcp_server/

# Whitelist automated tests
!tests/
!pytest.ini

# Whitelist the media-plan skill only
!.cursor/
.cursor/*
!.cursor/skills/
!.cursor/skills/**

# Ignore Python bytecode and local artifacts everywhere
__pycache__/
*.py[cod]
*$py.class
*.so
.DS_Store
*.DS_Store
.env
.env.*
